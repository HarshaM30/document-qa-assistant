# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173   # allowed CORS origin

# --- PostgreSQL 16 + pgvector (host port 5434 to avoid local conflicts) ---
POSTGRES_USER=docqa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docqa
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql+asyncpg://docqa:change-me@localhost:5434/docqa
TEST_DATABASE_URL=postgresql+asyncpg://docqa:change-me@localhost:5434/docqa_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Redis (host port 6380 to avoid local conflicts) ---
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# --- Auth / sessions ---
SESSION_SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets-token-urlsafe-64
SESSION_COOKIE_NAME=docqa_session
SESSION_COOKIE_SECURE=false         # true behind HTTPS
SESSION_TTL_HOURS=168

# --- LLM (LiteLLM). Provider "fake" is deterministic and needs no key. ---
LLM_PROVIDER=groq                   # groq | fake
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=low          # for reasoning models (gpt-oss); ignored otherwise
GROQ_API_KEY=your-groq-api-key
FAKE_LLM_TOKEN_DELAY_MS=0           # fake provider only: pause between streamed words

# Faithfulness judge for evals: must be a DIFFERENT model than LLM_MODEL
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b       # fallback: openai/gpt-oss-20b

# --- Local embeddings + reranker (fastembed / ONNX) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=2                 # ONNX threads; keeps CPU and memory use modest
FASTEMBED_CACHE_DIR=.cache/fastembed

# --- Chunking / retrieval ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_VECTOR_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=30
RETRIEVAL_EF_SEARCH=100             # HNSW search breadth (>= vector top-k)
RRF_K=60
RETRIEVAL_RERANK_CANDIDATES=30      # fused results passed to the cross-encoder
RERANK_ENABLED=true
RERANK_TOP_N=6
RERANK_BATCH_SIZE=4                  # larger batches raise peak memory, not speed
REFUSAL_MIN_RERANK_SCORE=0.0         # refuse without calling the LLM below this cross-encoder score

# --- Rate limiting (per user) ---
RATE_LIMIT_QUESTIONS_PER_MINUTE=5
RATE_LIMIT_QUESTIONS_PER_DAY=100

# --- Uploads / ingestion worker ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25
WORKER_MAX_JOBS=2
INGEST_MAX_RETRIES=3
INGEST_RETRY_BASE_DELAY_SECONDS=5   # exponential backoff: 5s, 10s, 20s, ...
WORKER_JOB_TIMEOUT_SECONDS=1800

# --- SEC EDGAR download (fair access: identify yourself, <= 10 req/s) ---
SEC_USER_AGENT="Your Name your.email@example.com"
SEC_FILINGS_PER_COMPANY=3
SEC_MAX_REQUESTS_PER_SECOND=5
RAW_DATA_DIR=data/raw
COMPANIES_FILE=data/companies.yaml
FILINGS_LOCK_FILE=data/filings.lock.json

# --- Evaluation (Groq free-tier budgeting; runs are resumable) ---
# Per-model budgets, kept below Groq's published limits (1K RPD, 200K TPD, 8K TPM)
EVAL_DAILY_REQUEST_BUDGET=900
EVAL_DAILY_TOKEN_BUDGET=180000
EVAL_TOKENS_PER_MINUTE=7000
EVAL_REQUEST_INTERVAL_SECONDS=2.5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
